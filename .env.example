# Copie ce fichier en .env, puis remplis-le.  (cp .env.example .env)

# Adresse où tu ouvres le panel dans ton navigateur (sans / à la fin).
# Elle doit être exactement la même que la « Redirect » de ton application Discord, plus /auth/callback.
PUBLIC_URL=http://192.168.2.12:8080

# Application Discord pour se connecter (https://discord.com/developers/applications › OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Ton ID Discord (et celui des autres admins), séparés par des virgules.
# Dans Discord : Paramètres › Avancés › Mode développeur, puis clic droit sur ton profil › Copier l'identifiant.
ADMIN_IDS=

# Limites d'un nouveau compte (l'admin peut les changer compte par compte dans le panel)
DEFAULT_MAX_BOTS=3
DEFAULT_MAX_RAM_MB=1024
DEFAULT_MAX_DISK_MB=2048

# Images Docker que les utilisateurs peuvent choisir (l'admin peut mettre n'importe laquelle)
ALLOWED_IMAGES=python:3.13-slim,python:3.12-slim,python:3.11-slim,node:22-slim,node:20-slim
PYTHON_IMAGE=python:3.13-slim
NODE_IMAGE=node:22-slim

# Taille max d'un téléversement (Mo)
MAX_UPLOAD_MB=100

# Ports que le panel peut donner aux bots qui ont un site ou un panel web (« Ouvrir un port web » dans Réglages)
PORT_RANGE=25500-25599

# Réseau Docker des bots (créé tout seul)
BOT_NETWORK=botpanel-bots

# Seulement si le panel trouve pas tout seul son dossier data sur la machine (message dans les logs) :
# HOST_DATA_DIR=/opt/bot-panel/data
